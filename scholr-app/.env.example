# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — NEVER expose to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Groq — AI weekly reports (OpenAI-compatible, free tier) ───────────────────
# Found at: https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Resend — transactional email ─────────────────────────────────────────────
# Found at: https://resend.com → API Keys
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Scholr <onboarding@resend.dev>

# ─── Stripe (optional — billing) ──────────────────────────────────────────────
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# ─── Cron — protects the weekly-report draft generator ────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`)
CRON_SECRET=your-long-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
